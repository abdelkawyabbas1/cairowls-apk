{
  "name": "premium-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npm run build && npx cap copy ios",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:add:android": "npx cap add android",
    "cap:open:android": "npx cap open android",
    "cap:copy:android": "npm run build && npx cap copy android",
    "android:run": "npm run cap:sync:android && npx cap run android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "7.6.8",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.4",
    "exceljs": "^4.4.0",
    "jeep-sqlite": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "1.11.0",
    "@capacitor/android": "7.6.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@capacitor/ios": "7.6.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
